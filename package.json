{
  "name": "controle-tarefas",
  "version": "1.0.0",
  "description": "Aplicação simples de tarefas com HTML, CSS, JavaScript, Node.js, SQLite e Jest",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
